<UserControl
  x:Class="DiscordChatExporter.Gui.Views.Components.DashboardView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:components="clr-namespace:DiscordChatExporter.Gui.ViewModels.Components"
  xmlns:materialStyles="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
  x:DataType="components:DashboardViewModel"
>
  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="12" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
      <materialStyles:Card Grid.Column="0">
        <TextBlock
          Margin="12,8"
          VerticalAlignment="Center"
          Text="{Binding LocalizationManager.DiscordOfflineModeNotice}"
          TextWrapping="Wrap"
        />
      </materialStyles:Card>
      <Button
        Grid.Column="1"
        Margin="8,0,0,0"
        Command="{Binding NavigateToConversionCommand}"
        Content="{Binding LocalizationManager.ConversionTooltip}"
        Theme="{DynamicResource MaterialFlatButton}"
      />
      <Button
        Grid.Column="2"
        Margin="8,0,0,0"
        Command="{Binding NavigateToLibraryCommand}"
        Content="{Binding LocalizationManager.LibraryTooltip}"
        Theme="{DynamicResource MaterialFlatButton}"
      />
      <Button
        Grid.Column="3"
        Margin="8,0,0,0"
        Command="{Binding ShowSettingsCommand}"
        Content="{Binding LocalizationManager.SettingsTooltip}"
        Theme="{DynamicResource MaterialFlatButton}"
      />
      <Button
        Grid.Column="4"
        Margin="8,0,0,0"
        Command="{Binding ShowDiagnosticsCommand}"
        Content="{Binding LocalizationManager.DiagnosticsTitle}"
        Theme="{DynamicResource MaterialFlatButton}"
      />
    </Grid>

    <Border Background="{DynamicResource MaterialCardBackgroundBrush}" Padding="32">
      <TextBlock
        MaxWidth="720"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="20"
        Text="{Binding LocalizationManager.DiscordOfflineModeNotice}"
        TextAlignment="Center"
        TextWrapping="Wrap"
      />
    </Border>
  </DockPanel>
</UserControl>
