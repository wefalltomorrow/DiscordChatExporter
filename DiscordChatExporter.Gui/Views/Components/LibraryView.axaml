<UserControl
  x:Class="DiscordChatExporter.Gui.Views.Components.LibraryView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:components="clr-namespace:DiscordChatExporter.Gui.ViewModels.Components"
  xmlns:converters="clr-namespace:DiscordChatExporter.Gui.Converters"
  xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
  xmlns:materialStyles="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
  x:Name="UserControl"
  x:DataType="components:LibraryViewModel"
>
  <DockPanel>
    <!--  Header  -->
    <StackPanel
      Background="{DynamicResource MaterialDarkBackgroundBrush}"
      DockPanel.Dock="Top"
      Orientation="Vertical"
    >
      <Grid Margin="12,12,8,12" ColumnDefinitions="Auto,*,Auto">
        <!--  Back button  -->
        <Button
          Grid.Column="0"
          Margin="0,0,8,0"
          Padding="8"
          VerticalAlignment="Center"
          Command="{Binding NavigateBackCommand}"
          Foreground="{DynamicResource MaterialDarkForegroundBrush}"
          Theme="{DynamicResource MaterialFlatButton}"
        >
          <Button.Content>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <materialIcons:MaterialIcon Width="20" Height="20" Kind="ArrowLeft" />
              <TextBlock
                VerticalAlignment="Center"
                Text="{Binding LocalizationManager.LibraryBackButtonText}"
              />
            </StackPanel>
          </Button.Content>
        </Button>

        <!--  Search box  -->
        <materialStyles:Card Grid.Column="1">
          <TextBox
            x:Name="SearchTextBox"
            FontSize="16"
            IsEnabled="{Binding HasSearchableExports}"
            PlaceholderText="{Binding LocalizationManager.LibrarySearchPlaceholder}"
            Text="{Binding SearchQuery}"
            Theme="{DynamicResource SoloTextBox}"
          >
            <TextBox.InnerLeftContent>
              <materialIcons:MaterialIcon
                Width="24"
                Height="24"
                Margin="4,0,8,0"
                Foreground="{DynamicResource PrimaryHueMidBrush}"
                Kind="Magnify"
              />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Button
                Margin="8,0,0,0"
                Padding="4"
                Command="{Binding SearchCommand}"
                IsDefault="True"
                Theme="{DynamicResource MaterialFlatButton}"
              >
                <materialIcons:MaterialIcon Width="24" Height="24" Kind="ArrowRight" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
        </materialStyles:Card>

        <!--  Scan folder button  -->
        <Button
          Grid.Column="2"
          Margin="8,0,0,0"
          Padding="8"
          VerticalAlignment="Center"
          Command="{Binding ScanFolderCommand}"
          Foreground="{DynamicResource MaterialDarkForegroundBrush}"
          Theme="{DynamicResource MaterialFlatButton}"
          ToolTip.Tip="{Binding LocalizationManager.LibraryScanFolderButtonText}"
        >
          <StackPanel Orientation="Horizontal" Spacing="4">
            <materialIcons:MaterialIcon Width="24" Height="24" Kind="FolderSearchOutline" />
            <TextBlock
              VerticalAlignment="Center"
              Text="{Binding LocalizationManager.LibraryScanFolderButtonText}"
            />
          </StackPanel>
        </Button>
      </Grid>

      <!--  Busy indicator  -->
      <ProgressBar Height="2" Background="Transparent" IsIndeterminate="{Binding IsBusy}" />
    </StackPanel>

    <!--  Body  -->
    <Panel Background="{DynamicResource MaterialCardBackgroundBrush}">
      <Grid RowDefinitions="Auto,*,Auto,*">
        <!--  Catalog header  -->
        <TextBlock
          Grid.Row="0"
          Margin="16,12,16,4"
          FontSize="16"
          FontWeight="SemiBold"
          Text="{Binding LocalizationManager.LibraryTitle}"
        />

        <!--  Empty-catalog hint  -->
        <TextBlock
          Grid.Row="1"
          Margin="16,8"
          VerticalAlignment="Top"
          FontSize="14"
          FontWeight="Light"
          IsVisible="{Binding !Entries.Count}"
          Text="{Binding LocalizationManager.LibraryNoExportsMessage}"
        />

        <!--  Catalog list  -->
        <ListBox
          Grid.Row="1"
          Margin="8,0"
          IsVisible="{Binding !!Entries.Count}"
          ItemsSource="{Binding Entries}"
          SelectionMode="Single"
        >
          <ListBox.Styles>
            <Style Selector="ListBox">
              <Style Selector="^ ListBoxItem">
                <Setter Property="Padding" Value="0" />
              </Style>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <materialStyles:Card Margin="4">
                <StackPanel Spacing="2">
                  <TextBlock FontSize="14" FontWeight="SemiBold">
                    <Run Text="{Binding GuildName, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding ChannelName, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock FontSize="12" FontWeight="Light" Opacity="0.8">
                    <Run Text="{Binding Format, Converter={x:Static converters:ExportFormatToStringConverter.Instance}, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding MessageCount, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding ExportedAt, Converter={x:Static converters:TimestampToStringConverter.Instance}, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock
                    FontSize="11"
                    FontWeight="Light"
                    Opacity="0.6"
                    Text="{Binding File, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                  />
                </StackPanel>
              </materialStyles:Card>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!--  Search-unavailable hint (only when there ARE exports but none are .db)  -->
        <TextBlock
          Grid.Row="2"
          Margin="16,12,16,4"
          FontSize="12"
          FontWeight="Light"
          Foreground="{DynamicResource PrimaryHueMidBrush}"
          IsVisible="{Binding ShowSearchUnavailable}"
          Text="{Binding LocalizationManager.LibrarySearchUnavailableMessage}"
        />

        <!--  Empty-results hint (only after a non-blank search returned nothing)  -->
        <TextBlock
          Grid.Row="3"
          Margin="16,8"
          VerticalAlignment="Top"
          FontSize="14"
          FontWeight="Light"
          IsVisible="{Binding ShowNoResults}"
          Text="{Binding LocalizationManager.LibraryEmptyResultsMessage}"
        />

        <!--  Results list  -->
        <ListBox
          Grid.Row="3"
          Margin="8,0,8,8"
          IsVisible="{Binding !!SearchResults.Count}"
          ItemsSource="{Binding SearchResults}"
          SelectionMode="Single"
        >
          <ListBox.Styles>
            <Style Selector="ListBox">
              <Style Selector="^ ListBoxItem">
                <Setter Property="Padding" Value="0" />
              </Style>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <materialStyles:Card Margin="4">
                <StackPanel Spacing="2">
                  <TextBlock FontSize="13" FontWeight="SemiBold">
                    <Run Text="{Binding SourceLabel, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding Hit.AuthorName, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding Hit.Timestamp, Converter={x:Static converters:TimestampToStringConverter.Instance}, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock
                    FontSize="13"
                    FontWeight="Light"
                    Text="{Binding Hit.Snippet, Mode=OneWay}"
                    TextWrapping="Wrap"
                  />
                </StackPanel>
              </materialStyles:Card>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
